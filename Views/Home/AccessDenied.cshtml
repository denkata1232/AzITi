@{
    ViewData["Title"] = "Отказан достъп";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-lg"
                 style="border-radius: 24px;
                background: #ffffff;">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill"
                           style="font-size: 5rem;
                            color: #a94442;">
                        </i>
                    </div>

                    <h1 class="fw-bold mb-3"
                        style="color: #344E41;">
                        Отказан достъп
                    </h1>

                    <p class="fs-5 text-secondary mb-3">
                        Нямате необходимите права
                        за достъп до тази страница.
                    </p>

                    <p class="text-muted mb-4">
                        Администраторският панел е
                        достъпен само за предварително
                        одобрени потребители.
                    </p>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-light border
                            rounded-4 mb-4">

                            <i class="bi bi-person-circle me-2"></i>

                            Влезли сте като:
                            <strong>
                                @User.FindFirst(
                                    System.Security.Claims.ClaimTypes.Email
                                )?.Value
                            </strong>
                        </div>
                    }

                    <div class="d-flex flex-wrap
                        justify-content-center gap-3">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn rounded-pill px-4 py-2
                            text-white fw-semibold"
                           style="background: #344E41;">

                            <i class="bi bi-house-door me-2"></i>
                            Начална страница
                        </a>

                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="btn btn-outline-secondary
                            rounded-pill px-4 py-2">

                            <i class="bi bi-box-arrow-right me-2"></i>
                            Изход от профила
                        </a>

                    </div>

                    <hr class="my-4" />

                    <p class="small text-muted mb-0">
                        Ако смятате, че трябва да имате
                        администраторски достъп,
                        свържете се с администратора
                        на платформата.
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>
