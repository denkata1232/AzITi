
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var isAdmin = isAuthenticated &&
        (await AuthorizationService.AuthorizeAsync(
            User, "СамоАдминистратори")).Succeeded;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Аз и ти</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;

            background: linear-gradient(
                90deg,
                #344E41 0%,
                #DAD7CD 12%,
                #DDD8B7 80%,
                #344E41 100%
            );

            color: #344E41;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
        }

        main {
            flex: 1 0 auto;
        }

        /* Навигация */
        .glass-header {
            background: rgba(52, 78, 65, 0.85);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            border-bottom:
                1px solid rgba(255, 255, 255, 0.15);

            box-shadow:
                0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.03em;
            color: #DAD7CD !important;
            font-size: 1.25rem;
            transition: opacity 0.2s;
        }

        .navbar-brand:hover {
            opacity: 0.85;
        }

        .nav-link {
            color: rgba(
                218, 215, 205, 0.85
            ) !important;

            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 1rem !important;
            border-radius: 999vw;

            transition: all 0.25s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #ffffff !important;
            background: rgba(
                255, 255, 255, 0.12
            );
        }

        /* Администраторско меню */
        .admin-nav-link {
            color: #ffffff !important;
            background: rgba(
                163, 177, 138, 0.25
            );
            border: 1px solid rgba(
                218, 215, 205, 0.35
            );
        }

        .admin-nav-link:hover {
            background: #A3B18A;
            color: #1f3328 !important;
        }

        .admin-indicator {
            color: #DAD7CD;
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* Профил */
        .profile-link {
            background: rgba(
                255, 255, 255, 0.75
            );

            border-radius: 999px;
            text-decoration: none;
            padding: 6px 14px;

            transition: background 0.2s;
        }

        .profile-link:hover {
            background: #ffffff;
        }

        /* Футър */
        .glass-footer {
            flex-shrink: 0;

            background: rgba(
                52, 78, 65, 0.9
            );

            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            border-top: 1px solid rgba(
                255, 255, 255, 0.15
            );

            color: #DAD7CD;
            margin-top: auto;
        }

        .footer-link {
            color: #A3B18A;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer-link:hover {
            color: #ffffff;
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <!-- Главна навигация -->
    <header class="sticky-top">

        <nav class="navbar navbar-expand-lg
                    navbar-dark glass-header py-3">

            <div class="container">

                <!-- Лого -->
                <a class="navbar-brand
                          d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/AzITi-logo.png"
                         alt="Лого на Аз и ти"
                         style="height: 92px;
                                width: auto;
                                object-fit: contain;" />

                    <span>Аз и ти</span>
                </a>

                <!-- Мобилно меню -->
                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Отвори менюто">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse
                            d-lg-inline-flex
                            justify-content-between
                            mt-2 mt-lg-0"
                     id="mainNavbar">

                    <!-- Основни страници -->
                    <ul class="navbar-nav gap-1 mx-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="AidCampaigns"
                               asp-action="Index">

                                <i class="bi bi-grid-fill me-1"></i>
                                Кампании
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Partners">

                                <i class="bi bi-handshake-fill me-1"></i>
                                Партньори
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                <i class="bi bi-people-fill me-1"></i>
                                За нас
                            </a>
                        </li>

                        @* Само за администратори *@
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link admin-nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="bi bi-shield-lock-fill me-1"></i>
                                    Админ панел
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Профил и вход -->
                    <div class="d-flex align-items-center
                                flex-wrap gap-3 mt-3 mt-lg-0">

                        @if (isAuthenticated)
                        {
                            @if (isAdmin)
                            {
                                <span class="admin-indicator">
                                    <i class="bi bi-patch-check-fill me-1"></i>
                                    Администратор
                                </span>
                            }

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="profile-link d-flex
                                      align-items-center gap-2
                                      shadow-sm border"
                               title="Моят профил">

                                <i class="bi bi-person-circle
                                          text-success fs-5"></i>

                                <span class="fw-bold text-dark small">
                                    @User.Identity?.Name
                                </span>
                            </a>

                            
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm rounded-pill px-3 fw-semibold">
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Изход
                                </button>
                            </form>

                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-sm rounded-pill
                                      px-4 fw-bold shadow-sm
                                      d-flex align-items-center
                                      gap-2 py-2 text-dark"
                               style="background-color: #DAD7CD;
                                      border: none;">

                                <i class="bi bi-google text-danger"></i>
                                Влез с Google
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- Съдържание -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Футър -->
    <footer class="glass-footer py-4">
        <div class="container">

            <div class="row align-items-center gy-3">

                <div class="col-md-6
                            text-center text-md-start">

                    <p class="mb-0 fw-medium">
                        &copy; 2026
                        <strong>Аз и ти</strong>
                        — Платформа за автоматизиране
                        на социални помощи
                    </p>

                    <small class="text-light opacity-75">
                        Разработена в партньорство
                        с фондация „Сам Постигам“
                        в подкрепа на ученици
                        и студенти.
                    </small>
                </div>

                <div class="col-md-6
                            text-center text-md-end">

                    <div class="d-flex
                                justify-content-center
                                justify-content-md-end
                                gap-3">

                        <a asp-controller="Home"
                           asp-action="About"
                           class="footer-link small">
                            Автори
                        </a>

                        <span class="opacity-50">•</span>

                        <a asp-controller="Home"
                           asp-action="Partners"
                           class="footer-link small">
                            Партньори
                        </a>

                        <span class="opacity-50">•</span>

                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="footer-link small">
                            Поверителност
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>
